---
import ImportBackup from '../components/ImportBackup';
import MyLists from '../components/MyLists';
import CreateList from '../components/CreateList';
import Base from '../layouts/Base.astro';
---

<Base title="DivvyUp - split expenses with friends">
  <!-- flex gap, not space-y: Astro wraps each island in an element that space-y would skip over -->
  <div class="flex flex-col gap-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Split expenses, stay friends.</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        Make a list, add the people, and log who paid what. DivvyUp works out who owes whom. No sign-up: share a link and everyone can add expenses.
      </p>
    </div>
    <CreateList client:load />
    <MyLists client:load />
    <ImportBackup client:load />
  </div>
</Base>
