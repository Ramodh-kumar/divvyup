{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "divvyup",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Free, built-in request logs and errors in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "divvyup",
      // From `npx wrangler d1 create divvyup`. The id is not a secret; access is controlled by your Cloudflare login.
      "database_id": "6d0d3b41-d80f-4acd-9f72-fab75c33b6ea",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets are NOT stored here. TURNSTILE_SECRET is set with `npx wrangler secret put TURNSTILE_SECRET`
  // and TURNSTILE_SITE_KEY (public) in the dashboard or the "vars" block; see README.md.
}
