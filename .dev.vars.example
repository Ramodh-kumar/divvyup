# Local-only settings. Copy this file to `.dev.vars` (which is git-ignored) to try Turnstile locally.
# These are Cloudflare's published TEST keys: the widget always passes and verification always succeeds.
# Never use them in production; create a real widget in the Cloudflare dashboard (see README.md).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Other test keys, for checking the failure paths:
#   always fails:   site key 2x00000000000000000000AB   secret 2x0000000000000000000000000000000AA
#   forces a visible challenge: site key 3x00000000000000000000FF
