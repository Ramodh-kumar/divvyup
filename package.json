{
  "name": "divvyup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Split expenses with friends. Astro + Cloudflare Pages + D1.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --local",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply divvyup --local",
    "db:migrate:remote": "wrangler d1 migrations apply divvyup --remote"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Ramodh-kumar/divvyup.git" },
  "bugs": { "url": "https://github.com/Ramodh-kumar/divvyup/issues" },
  "homepage": "https://github.com/Ramodh-kumar/divvyup#readme",
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
